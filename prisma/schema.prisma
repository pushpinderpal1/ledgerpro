generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── TENANCY LAYER ───────────────────────────────────────────────────────────

model LegalEntity {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  taxId       String?
  address     String?
  phone       String?
  email       String?
  currency    String   @default("USD")          // functional currency for this entity's books
  fiscalMonth Int      @default(1)
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Corporate group structure ──
  parentEntityId   String?                       // null = top-level (holding co or standalone)
  ownershipPercent Decimal  @default(100) @db.Decimal(7, 4)   // % the parent owns of this entity
  acquisitionDate  DateTime?                     // when the parent acquired this subsidiary
  entityType       EntityType @default(STANDALONE)
  // Self-relation: parent ↔ children
  parent           LegalEntity?  @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: SetNull)
  children         LegalEntity[] @relation("EntityHierarchy")

  // ── MIS / multi-dimensional accounting (opt-in per entity) ──
  misEnabled              Boolean @default(false)             // master toggle
  misRequiredForTypes     String  @default("")                // CSV of AccountType values, e.g. "EXPENSE,REVENUE,COGS"
  misAllowOverride        Boolean @default(false)             // when true, requiredForTypes is downgraded to optional

  userAccess     EntityAccess[]
  accounts       Account[]
  journalEntries JournalEntry[]
  apInvoices     ApInvoice[]
  employees      Employee[]
  payrollRuns    PayrollRun[]
  budgets        Budget[]
  clients        Client[]
  iifImports     IifImport[]
  auditLogs      AuditLog[]
  payments       Payment[]
  reconciliations BankReconciliation[]
  lockedPeriods   LockedPeriod[]
  idempotencyKeys IdempotencyKey[]
  assetCategories AssetCategory[]
  fixedAssets     FixedAsset[]
  depreciationEntries DepreciationEntry[]
  misCodes       MisCode[]
  vendorReconciliations VendorReconciliation[]
  apRequests     ApRequest[]
  attachments    Attachment[]
  statementTemplates StatementTemplate[]
  paymentModes   PaymentMode[]
  receipts       Receipt[]

  @@map("legal_entities")
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  passwordHash String
  avatarUrl   String?
  isSuperAdmin Boolean  @default(false)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ── Two-factor authentication ──
  totpSecret     String?                          // AES-GCM ciphertext (base64)
  totpEnabled    Boolean   @default(false)
  totpVerifiedAt DateTime?

  entityAccess EntityAccess[]
  auditLogs    AuditLog[]
  sessions     Session[]
  backupCodes  BackupCode[]

  @@map("users")
}

model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String                                  // bcrypt hash of the code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("backup_codes")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model EntityAccess {
  id        String     @id @default(cuid())
  userId    String
  entityId  String
  role      EntityRole
  isActive  Boolean    @default(true)
  grantedAt DateTime   @default(now())
  grantedBy String?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@map("entity_access")
}

enum EntityRole {
  OWNER
  ADMIN
  ACCOUNTANT
  AUDITOR
  AP_CLERK
  PAYROLL_CLERK
  CLIENT_VIEW
}

// ─── CLIENTS ─────────────────────────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  entityId    String
  code        String
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  entity     LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  apInvoices ApInvoice[]

  @@unique([entityId, code])
  @@map("clients")
}

// ─── CHART OF ACCOUNTS ───────────────────────────────────────────────────────

model Account {
  id            String      @id @default(cuid())
  entityId      String
  code          String
  name          String
  type          AccountType
  subType       String?
  description   String?
  parentId      String?
  isActive      Boolean     @default(true)
  isBankAccount Boolean     @default(false)
  taxCode       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  entity       LegalEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  parent       Account?     @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children     Account[]    @relation("AccountHierarchy")
  journalLines JournalLine[]
  apInvoices   ApInvoice[]
  apRequests   ApRequest[]  @relation("ApRequestAccount")
  receiptDeposits Receipt[] @relation("ReceiptDepositAccount")
  receiptCredits  Receipt[] @relation("ReceiptCreditAccount")
  budgetLines  BudgetLine[]
  paymentsFrom Payment[]            @relation("PaymentBankAccount")
  reconciliations BankReconciliation[]
  // Three roles an account can play in a fixed-asset category:
  categoriesAssetAccount      AssetCategory[] @relation("CategoryAssetAccount")
  categoriesAccumDepAccount   AssetCategory[] @relation("CategoryAccumDepAccount")
  categoriesDepExpenseAccount AssetCategory[] @relation("CategoryDepExpenseAccount")

  @@unique([entityId, code])
  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  COGS
}

// ─── CORPORATE GROUP STRUCTURE ───────────────────────────────────────────────
enum EntityType {
  STANDALONE        // not part of any group
  HOLDING           // parent — typically owns one or more subsidiaries
  SUBSIDIARY        // owned by a holding co (could be partially or wholly)
  BRANCH            // unincorporated arm of a parent; usually no separate accounts but supported
}

// Exchange rates between currency pairs. Lookups pick the row with the largest
// effectiveDate <= the transaction date, so rates are "what was true at posting."
// Both directions are not pre-computed — caller queries the right pair or inverts.
model FxRate {
  id             String   @id @default(cuid())
  fromCurrency   String                          // e.g. "USD"
  toCurrency     String                          // e.g. "EUR"
  rate           Decimal  @db.Decimal(18, 8)     // 1 fromCurrency = `rate` toCurrency
  effectiveDate  DateTime                        // date from which this rate applies
  source         String?                         // "manual", "RBI", "ECB", "exchangerate-api", etc.
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())

  @@unique([fromCurrency, toCurrency, effectiveDate])
  @@index([fromCurrency, toCurrency])
  @@map("fx_rates")
}

// ─── JOURNAL ENTRIES ─────────────────────────────────────────────────────────

model JournalEntry {
  id          String        @id @default(cuid())
  entityId    String
  ref         String
  date        DateTime
  description String
  memo        String?
  status      JournalStatus @default(DRAFT)
  source      String?
  recurringId String?
  createdBy   String?
  postedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  entity LegalEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  lines  JournalLine[]
  receiptPosted    Receipt? @relation("ReceiptJournalEntry")
  receiptVoided    Receipt? @relation("ReceiptVoidJournalEntry")

  @@unique([entityId, ref])
  @@map("journal_entries")
}

model JournalLine {
  id          String  @id @default(cuid())
  entryId     String
  accountId   String
  description String?
  debit       Decimal @default(0) @db.Decimal(18, 2)
  credit      Decimal @default(0) @db.Decimal(18, 2)
  lineOrder   Int     @default(0)

  // ── Bank reconciliation ──
  clearedStatus  ClearedStatus       @default(UNCLEARED)
  clearedDate    DateTime?
  reconciledId   String?

  // ── MIS / department tagging (optional, only used when entity.misEnabled) ──
  misCodeId      String?

  entry        JournalEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reconciled   BankReconciliation? @relation(fields: [reconciledId], references: [id], onDelete: SetNull)
  misCode      MisCode?            @relation(fields: [misCodeId], references: [id], onDelete: SetNull)

  @@index([accountId, clearedStatus])
  @@index([misCodeId])
  @@map("journal_lines")
}

enum ClearedStatus {
  UNCLEARED  // not yet matched
  CLEARED    // marked cleared by user / matched to statement
  RECONCILED // locked into a finalized reconciliation
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
  RECURRING
}

// ─── AP TRACKER ──────────────────────────────────────────────────────────────

model ApInvoice {
  id          String   @id @default(cuid())
  entityId    String
  clientId    String?
  accountId   String?
  vendor      String
  invoiceNo   String
  invoiceDate DateTime
  dueDate     DateTime
  amount      Decimal  @db.Decimal(18, 2)
  amountPaid  Decimal  @default(0) @db.Decimal(18, 2)
  status      ApStatus @default(PENDING)
  notes       String?
  attachment  String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity   LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  client   Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  account  Account?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payments ApPayment[]
  apRequest ApRequest? @relation("ApRequestInvoice")

  @@map("ap_invoices")
}

model ApPayment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(18, 2)
  paidOn    DateTime
  method    String?
  reference String?
  createdAt DateTime @default(now())

  invoice ApInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("ap_payments")
}

enum ApStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

// ─── PAYROLL ─────────────────────────────────────────────────────────────────

model Employee {
  id              String       @id @default(cuid())
  entityId        String
  employeeNo      String
  firstName       String
  lastName        String
  ssnEncrypted    String?
  email           String?
  phone           String?
  address         String?
  startDate       DateTime
  endDate         DateTime?
  payType         PayType
  salary          Decimal?     @db.Decimal(18, 2)
  hourlyRate      Decimal?     @db.Decimal(10, 2)
  filingStatus    FilingStatus
  allowances      Int          @default(1)
  state           String       @default("NY")
  retirement401k  Decimal      @default(0) @db.Decimal(5, 4)
  healthDeduction Decimal      @default(0) @db.Decimal(10, 2)
  isActive        Boolean      @default(true)
  department      String?
  jobTitle        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  entity      LegalEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  payrollRuns PayrollRun[]
  w2Records   W2Record[]

  @@unique([entityId, employeeNo])
  @@map("employees")
}

model PayrollRun {
  id          String        @id @default(cuid())
  entityId    String
  employeeId  String
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime
  grossPay    Decimal       @db.Decimal(18, 2)
  fedTax      Decimal       @db.Decimal(18, 2)
  stateTax    Decimal       @db.Decimal(18, 2)
  ssTax       Decimal       @db.Decimal(18, 2)
  medicareTax Decimal       @db.Decimal(18, 2)
  retirement  Decimal       @default(0) @db.Decimal(18, 2)
  healthDed   Decimal       @default(0) @db.Decimal(18, 2)
  otherDed    Decimal       @default(0) @db.Decimal(18, 2)
  netPay      Decimal       @db.Decimal(18, 2)
  hoursWorked Decimal?      @db.Decimal(6, 2)
  status      PayrollStatus @default(DRAFT)
  createdAt   DateTime      @default(now())

  entity   LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("payroll_runs")
}

model W2Record {
  id           String    @id @default(cuid())
  employeeId   String
  taxYear      Int
  box1Wages    Decimal   @db.Decimal(18, 2)
  box2FedTax   Decimal   @db.Decimal(18, 2)
  box3SsWages  Decimal   @db.Decimal(18, 2)
  box4SsTax    Decimal   @db.Decimal(18, 2)
  box5MedWages Decimal   @db.Decimal(18, 2)
  box6MedTax   Decimal   @db.Decimal(18, 2)
  box12Code    String?
  box12Amount  Decimal?  @db.Decimal(18, 2)
  box13Retire  Boolean   @default(false)
  status       String    @default("DRAFT")
  filedAt      DateTime?
  createdAt    DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, taxYear])
  @@map("w2_records")
}

enum PayType {
  SALARY
  HOURLY
  COMMISSION
}

enum FilingStatus {
  SINGLE
  MARRIED
  MFS
  HH
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

// ─── BUDGET & MIS ────────────────────────────────────────────────────────────

model Budget {
  id         String   @id @default(cuid())
  entityId   String
  name       String
  fiscalYear Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  entity LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  lines  BudgetLine[]

  @@unique([entityId, fiscalYear, name])
  @@map("budgets")
}

model BudgetLine {
  id        String  @id @default(cuid())
  budgetId  String
  accountId String
  month     Int
  amount    Decimal @db.Decimal(18, 2)

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([budgetId, accountId, month])
  @@map("budget_lines")
}

// ─── IIF IMPORTS ─────────────────────────────────────────────────────────────

model IifImport {
  id         String    @id @default(cuid())
  entityId   String
  filename   String
  type       String
  rawContent String
  rowCount   Int       @default(0)
  status     String    @default("PENDING")
  errors     String?
  importedAt DateTime?
  createdAt  DateTime  @default(now())

  entity LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@map("iif_imports")
}

// ─── PAYMENTS (Cheque & ACH) ─────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  entityId      String
  bankAccountId String                                  // the Account money is drawn from (a bank account)
  method        PaymentMethod
  status        PaymentStatus @default(DRAFT)

  payeeName     String
  payeeClientId String?                                 // optional link to a Client/vendor
  amount        Decimal       @db.Decimal(18, 2)
  paymentDate   DateTime
  memo          String?

  // ── Cheque-specific ──
  chequeNo      String?

  // ── ACH-specific ──
  achRoutingNo  String?
  achAccountNo  String?                                 // store masked/last-4 in practice
  achAccountType String?                                // CHECKING | SAVINGS
  achTraceNo    String?
  achBatchId    String?
  achEffectiveDate DateTime?

  // ── Bookkeeping links ──
  expenseAccountId String?                              // offsetting account (expense/AP/etc.)
  journalEntryId   String?  @unique                     // the auto-generated JE
  apInvoiceId      String?                              // if paying an AP invoice
  voidedAt         DateTime?
  voidReason       String?

  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  entity      LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  bankAccount Account     @relation("PaymentBankAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@unique([entityId, bankAccountId, chequeNo])
  @@index([entityId, method])
  @@index([entityId, status])
  @@map("payments")
}

enum PaymentMethod {
  CHEQUE
  ACH
}

enum PaymentStatus {
  DRAFT      // created, not yet posted to GL
  ISSUED     // posted; cheque printed / ACH submitted
  CLEARED    // cleared the bank
  VOID
}

// ─── BANK RECONCILIATION ─────────────────────────────────────────────────────

model BankReconciliation {
  id              String           @id @default(cuid())
  entityId        String
  bankAccountId   String

  statementDate   DateTime
  beginningBalance Decimal         @db.Decimal(18, 2)
  endingBalance   Decimal          @db.Decimal(18, 2)

  status          ReconStatus      @default(IN_PROGRESS)
  statementFile   String?                              // original uploaded filename
  finishedAt      DateTime?
  finishedBy      String?
  notes           String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  entity         LegalEntity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  bankAccount    Account          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  clearedLines   JournalLine[]
  statementLines StatementLine[]

  @@index([entityId, bankAccountId])
  @@map("bank_reconciliations")
}

enum ReconStatus {
  IN_PROGRESS
  COMPLETED
}

// Parsed rows from an uploaded bank statement (CSV/OFX). Used to auto-match
// against uncleared journal lines during reconciliation.
model StatementLine {
  id             String   @id @default(cuid())
  reconciliationId String
  date           DateTime
  description    String
  amount         Decimal  @db.Decimal(18, 2)            // signed: + deposit, - withdrawal
  reference      String?
  matchedLineId  String?                                // journalLine id it was matched to
  isMatched      Boolean  @default(false)
  createdAt      DateTime @default(now())

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([reconciliationId])
  @@map("statement_lines")
}

// ─── PERIOD LOCKING ──────────────────────────────────────────────────────────
// Closes a fiscal period so no journal entries / payments dated on or before
// `periodEnd` can be created or modified. OWNER/ADMIN can unlock if needed.
model LockedPeriod {
  id         String   @id @default(cuid())
  entityId   String
  periodEnd  DateTime                                 // inclusive cutoff
  lockedAt   DateTime @default(now())
  lockedBy   String?
  reason     String?
  releasedAt DateTime?
  releasedBy String?

  entity LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, periodEnd])
  @@index([entityId, releasedAt])
  @@map("locked_periods")
}

// ─── IDEMPOTENCY KEYS ─────────────────────────────────────────────────────────
// Caches request outcomes so safe retries don't create duplicate payments / JEs.
// Honored when an Idempotency-Key header is supplied to mutating endpoints.
model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String                                // user-supplied UUID
  entityId       String
  userId         String?
  method         String
  path           String
  requestHash    String                                // SHA-256 of body
  responseStatus Int
  responseBody   String                                // JSON
  createdAt      DateTime @default(now())

  entity LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, key])
  @@index([createdAt])                                 // for periodic purge
  @@map("idempotency_keys")
}

// ─── FIXED ASSET REGISTER ────────────────────────────────────────────────────
// Three pieces:
//   AssetCategory  → policy: depreciation method + GL accounts for postings
//   FixedAsset     → individual assets purchased and tracked
//   DepreciationEntry → one row per asset per period, links to the JE that
//                       booked DR Dep Expense / CR Accumulated Depreciation

enum DepreciationMethod {
  STRAIGHT_LINE        // (cost - salvage) / useful life, equal monthly slices
  DECLINING_BALANCE    // bookValue × monthlyRate, until salvage floor
}

enum AssetStatus {
  ACTIVE               // currently depreciating
  DISPOSED             // sold/scrapped — no further depreciation
  FULLY_DEPRECIATED    // book value reached salvage — no further depreciation
}

model AssetCategory {
  id                       String   @id @default(cuid())
  entityId                 String
  name                     String                                 // e.g. "Buildings", "Vehicles", "Computer Equipment"
  description              String?
  depreciationMethod       DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeMonths         Int                                    // default for new assets in this category
  depreciationRatePercent  Decimal  @db.Decimal(7, 4)              // annual % (e.g. 10.0000 for 10%)

  // Three GL accounts that postings touch for this category:
  assetAccountId           String                                 // ASSET: holds acquisition cost
  accumDepAccountId        String                                 // ASSET (contra): credit balance reduces net BV
  depExpenseAccountId      String                                 // EXPENSE: the period's depreciation

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  entity               LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  assetAccount         Account     @relation("CategoryAssetAccount",     fields: [assetAccountId],     references: [id], onDelete: Restrict)
  accumDepAccount      Account     @relation("CategoryAccumDepAccount",  fields: [accumDepAccountId],  references: [id], onDelete: Restrict)
  depExpenseAccount    Account     @relation("CategoryDepExpenseAccount", fields: [depExpenseAccountId], references: [id], onDelete: Restrict)
  assets               FixedAsset[]

  @@unique([entityId, name])
  @@map("asset_categories")
}

model FixedAsset {
  id                      String   @id @default(cuid())
  entityId                String
  categoryId              String

  assetNo                 String                                  // human-readable, unique within entity
  description             String
  acquisitionDate         DateTime
  cost                    Decimal  @db.Decimal(18, 2)
  salvageValue            Decimal  @default(0) @db.Decimal(18, 2) // floor below which depreciation stops
  usefulLifeMonths        Int                                     // can override category default
  depreciationMethod      DepreciationMethod
  depreciationRatePercent Decimal  @db.Decimal(7, 4)

  status                  AssetStatus @default(ACTIVE)
  disposalDate            DateTime?
  disposalProceeds        Decimal? @db.Decimal(18, 2)
  location                String?
  serialNumber            String?
  notes                   String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  entity                  LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  category                AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  depreciationEntries     DepreciationEntry[]

  @@unique([entityId, assetNo])
  @@index([entityId, status])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id              String   @id @default(cuid())
  fixedAssetId    String
  entityId        String
  periodEnd       DateTime                                        // last day of the period this entry covers
  amount          Decimal  @db.Decimal(18, 2)
  bookValueAfter  Decimal  @db.Decimal(18, 2)                     // closing BV — useful for the asset schedule
  journalEntryId  String?                                         // the shared JE for the run (per-category aggregation)
  createdAt       DateTime @default(now())

  fixedAsset      FixedAsset  @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)
  entity          LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([fixedAssetId, periodEnd])          // idempotency: one entry per asset per period
  @@index([entityId, periodEnd])
  @@map("depreciation_entries")
}

// ─── VENDOR RECONCILIATION ───────────────────────────────────────────────────
// Pairs a vendor's external statement balance against the entity's internal
// AP records, captures the difference, and lets the user investigate before
// finalizing. Statement-line-level matching is intentionally deferred to v2
// in favor of getting the balance comparison + audit trail in place first.

enum VendorReconStatus {
  DRAFT
  FINALIZED
}

model VendorReconciliation {
  id                String   @id @default(cuid())
  entityId          String
  vendor            String                                  // free-text vendor name (matches ApInvoice.vendor)
  statementDate     DateTime
  statementBalance  Decimal  @db.Decimal(18, 2)             // what the vendor's statement says
  internalBalance   Decimal  @db.Decimal(18, 2)             // computed from internal AP records at finalize time
  difference        Decimal  @db.Decimal(18, 2)             // statementBalance - internalBalance
  status            VendorReconStatus @default(DRAFT)
  notes             String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  finalizedAt       DateTime?
  finalizedBy       String?

  entity            LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, statementDate])
  @@index([entityId, vendor])
  @@map("vendor_reconciliations")
}

// ─── MIS CODES (DEPARTMENTS / DIMENSIONS) ────────────────────────────────────
// Opt-in per entity. Users define their MIS codes (typically up to 10) and
// posted journal lines can be tagged with one. Reports can then break down
// by department.
//
// Soft-delete via isActive — codes that have been used in postings should
// not be hard-deleted, so reports continue to render historical data.

model MisCode {
  id           String   @id @default(cuid())
  entityId     String
  code         String                                 // user-visible identifier, e.g. "DEPT01"
  department   String                                 // human-friendly label, e.g. "Sales — North"
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entity       LegalEntity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([entityId, code])
  @@index([entityId, isActive])
  @@map("mis_codes")
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  entityId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  entity LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ─── AP REQUEST WORKFLOW ──────────────────────────────────────────────────────
// Maker-checker workflow for expense AP. Three roles:
//   Requester  — creates a request with invoice attachment + GL code + amount
//   Approver   — approves, returns to requester (with comments)
//   Accountant — posts to GL (creates ApInvoice + JE), can correct fields,
//                or return to approver/requester
//
// Once POSTED, an ApInvoice is created and linked via apInvoiceId. The
// existing ApInvoice flow (which posts its own journal entry) is bypassed
// in favor of an explicit JE created here so we have full control.

enum ApRequestStatus {
  SUBMITTED                  // awaiting approver
  APPROVED                   // awaiting accountant to post
  POSTED                     // accountant posted to GL
  RETURNED_TO_REQUESTER      // sent back from approver or accountant; needs requester fix
  RETURNED_TO_APPROVER       // sent back from accountant; needs approver re-review
}

enum ApPaymentMode {
  ACH
  CHEQUE
  WIRE
  OTHER
}

model Attachment {
  id         String      @id @default(cuid())
  entityId   String
  filename   String
  mimeType   String
  size       Int                                     // bytes
  data       Bytes                                   // file content
  uploadedBy String?                                 // userId (no FK to avoid User-relation explosion)
  createdAt  DateTime    @default(now())

  entity     LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  apRequests ApRequest[]

  @@index([entityId])
  @@map("attachments")
}

model ApRequest {
  id              String           @id @default(cuid())
  entityId        String

  // Invoice header fields (mirror ApInvoice for transition)
  vendor          String
  invoiceNo       String
  invoiceDate     DateTime
  dueDate         DateTime?
  amount          Decimal          @db.Decimal(18, 2)
  accountId       String                                       // expense GL
  paymentMode     ApPaymentMode?
  description     String?

  // Attachment (optional but practically required)
  attachmentId    String?

  // Workflow
  status          ApRequestStatus  @default(SUBMITTED)
  requesterId     String                                       // user who submitted
  approverId      String?                                      // user who approved (once APPROVED)
  accountantId    String?                                      // user who posted (once POSTED)

  submittedAt     DateTime         @default(now())
  approvedAt      DateTime?
  postedAt        DateTime?

  // Link to the ApInvoice created when posted
  apInvoiceId     String?          @unique

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  entity          LegalEntity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account         Account          @relation("ApRequestAccount", fields: [accountId], references: [id], onDelete: Restrict)
  attachment      Attachment?      @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  apInvoice       ApInvoice?       @relation("ApRequestInvoice", fields: [apInvoiceId], references: [id], onDelete: SetNull)
  comments        ApRequestComment[]

  @@index([entityId, status])
  @@index([requesterId])
  @@map("ap_requests")
}

model ApRequestComment {
  id          String    @id @default(cuid())
  apRequestId String
  userId      String                                  // who acted (no FK; keep User clean)
  action      String                                  // SUBMITTED, APPROVED, RETURNED_TO_REQUESTER, etc.
  comment     String?
  createdAt   DateTime  @default(now())

  apRequest   ApRequest @relation(fields: [apRequestId], references: [id], onDelete: Cascade)

  @@index([apRequestId])
  @@map("ap_request_comments")
}

// ─── CUSTOM STATEMENT TEMPLATES ──────────────────────────────────────────────
// User-defined financial statement layouts. Each template has an ordered list
// of lines (stored as JSON). At runtime, each line is rendered against the
// entity's posted journal data for the requested date range.
//
// Line types:
//   HEADER    — section header, no value
//   ACCOUNT   — single account; shows its natural balance for the range
//   GROUP     — multiple accounts; shows the sum of their natural balances
//   SUBTOTAL  — sum of all ACCOUNT and GROUP lines since previous SUBTOTAL
//   SPACER    — blank row for visual separation
//
// Lines stored as JSON gives the user full reorder/edit flexibility without
// schema churn. Validation happens in the API + runner libraries.

model StatementTemplate {
  id          String   @id @default(cuid())
  entityId    String
  name        String
  description String?
  lines       Json                                  // array of line objects (see runner.ts for shape)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity      LegalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, name])
  @@index([entityId])
  @@map("statement_templates")
}

// ─── PAYMENT MODES + RECEIPTS ─────────────────────────────────────────────────
// Configurable payment-method catalog shared by AP payments and Receipts.
// Seeded with sensible defaults the first time an entity is queried (lazy
// seed in the API).
//
// PaymentMode.kind controls which transaction types can use a given mode:
//   PAYMENT — outgoing only (AP)
//   RECEIPT — incoming only (AR)
//   BOTH    — works for both
//
// Receipts are the income counterpart to AP Payments. Each Receipt creates
// a balanced journal entry: DR Deposit account / CR Credit account
// (typically a revenue or AR account).

enum PaymentModeKind {
  PAYMENT
  RECEIPT
  BOTH
}

model PaymentMode {
  id          String          @id @default(cuid())
  entityId    String
  name        String                              // display: "Cheque", "Wire Transfer"
  code        String                              // canonical: "CHEQUE", "WIRE"
  kind        PaymentModeKind @default(BOTH)
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  entity      LegalEntity     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  receipts    Receipt[]

  @@unique([entityId, code])
  @@index([entityId])
  @@map("payment_modes")
}

enum ReceiptStatus {
  POSTED
  VOID
}

model Receipt {
  id              String        @id @default(cuid())
  entityId        String
  receiptNo       String                                  // auto-generated: RCP-YYYY-NNNN
  receivedFrom    String                                  // payer name (customer)
  receiptDate     DateTime
  amount          Decimal       @db.Decimal(18, 2)
  paymentModeId   String
  reference       String?
  description     String?

  // Posting accounts
  depositAccountId String                                 // DR — bank account receiving funds
  creditAccountId  String                                 // CR — revenue / AR account

  status          ReceiptStatus @default(POSTED)
  voidedAt        DateTime?
  voidedBy        String?

  journalEntryId  String?       @unique                   // link to posted JE
  voidJournalEntryId String?    @unique                   // link to reversing JE on void
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  entity          LegalEntity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  paymentMode     PaymentMode   @relation(fields: [paymentModeId], references: [id], onDelete: Restrict)
  depositAccount  Account       @relation("ReceiptDepositAccount", fields: [depositAccountId], references: [id], onDelete: Restrict)
  creditAccount   Account       @relation("ReceiptCreditAccount",  fields: [creditAccountId],  references: [id], onDelete: Restrict)
  journalEntry    JournalEntry? @relation("ReceiptJournalEntry",     fields: [journalEntryId],     references: [id], onDelete: SetNull)
  voidJournalEntry JournalEntry? @relation("ReceiptVoidJournalEntry", fields: [voidJournalEntryId], references: [id], onDelete: SetNull)

  @@unique([entityId, receiptNo])
  @@index([entityId, status])
  @@index([entityId, receiptDate])
  @@map("receipts")
}
